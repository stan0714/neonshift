# 後端環境變數（SD 8）。複製為 .env 後填入；.env 已被 gitignore。
NODE_ENV=development
APP_ENV=local            # local | dev | demo；dev／demo 必須同時給 PROGRAM_ID 與 DATABASE_URL
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=65536
DATABASE_URL=postgres://neonshift:neonshift_dev@localhost:5432/neonshift
CLUSTER_ID=1             # devnet = 1、localnet = 2
PROGRAM_ID=              # 部署後填入；與 App build-time 設定成組
SIWS_DOMAIN=neonshift.cc  # SIWS domain／JWT iss；dev 也用正式網域（App 端固定）
SIWS_URI=https://neonshift.cc
JWT_SECRET=               # ≥ 32 bytes 隨機值；dev／demo 必填，由受管 secret 注入
