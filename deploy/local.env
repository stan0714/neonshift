# 本機環境：LiteSVM 測試與 docker compose 後端；不部署鏈上程式
ENV_NAME=local
CLUSTER=localnet
CLUSTER_ID=2
RPC_URL=http://127.0.0.1:8899
KEY_DIR=$HOME/.config/neonshift/local
ADMIN_KEYPAIR=$KEY_DIR/admin.json
PROGRAM_KEYPAIR=$KEY_DIR/neonshift_core-keypair.json
ATTESTOR_KEYPAIR=$KEY_DIR/attestor.json
API_URL=http://localhost:3000/v1
PROGRAM_ID=
TSKR_MINT=
REWARD_VAULT=
TREASURY_VAULT=
TSKR_TOTAL_SUPPLY=1000000
TSKR_REWARD_FUND=200000
