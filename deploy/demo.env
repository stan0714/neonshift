# demo 環境（devnet 錄影與評審／提交版 APK）。公開資訊與路徑；金鑰在 ~/.config/neonshift/demo/
# 2026-09-22 決定（PG-D-01）：本屆提交版沿用 dev 的鏈上部署（program／tSKR／vault 同 dev.env），
# 因 api.neonshift.cc 只有一套後端與 attestor；dev／demo 差異只在 App 建置設定（無展示覆寫、https、無 DEV_ROUTE）。正式上架時再分離。
ENV_NAME=demo
CLUSTER=devnet
CLUSTER_ID=1
RPC_URL=https://api.devnet.solana.com
KEY_DIR=$HOME/.config/neonshift/demo
ADMIN_KEYPAIR=$KEY_DIR/admin.json
PROGRAM_KEYPAIR=$KEY_DIR/neonshift_core-keypair.json
ATTESTOR_KEYPAIR=$KEY_DIR/attestor.json
API_URL=https://api.neonshift.cc/v1
# 沿用 dev（見上）；KEY_DIR 仍指向 demo 目錄，鏈上管理操作請用 dev.env
PROGRAM_ID=6MhVoQHdEpY2hqkaNJMkT2vHWakfnGfEYDgCtJzh6ENA
TSKR_MINT=2itshf7Xup3WZeeDRSXbstv4nbPcjfiLhdDpcQjU7RtZ
REWARD_VAULT=335bF9gfo4FFpmhXR32hqRz7Ybqo82tz5XBhLLXeueRt
TREASURY_VAULT=3EjLT6m2PGPvWd1EsyFZCkcC9A4g1aiP3iN8b2DjA6vM
# 代幣（BRD 8.5 假設）：總供給 1,000,000、獎勵金庫預撥 200,000；單位 tSKR
TSKR_TOTAL_SUPPLY=1000000
TSKR_REWARD_FUND=200000
