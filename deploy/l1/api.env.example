# /etc/neonshift/api.env（root:neonshift 0640）。dev 環境；鏈上參數需與 deploy/dev.env 成組。
NODE_ENV=production
APP_ENV=dev
HOST=0.0.0.0
PORT=6080
LOG_LEVEL=info
DATABASE_URL=postgres://neonshift:CHANGE_ME@127.0.0.1:5432/neonshift
CLUSTER_ID=1
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=6MhVoQHdEpY2hqkaNJMkT2vHWakfnGfEYDgCtJzh6ENA
SIWS_DOMAIN=neonshift.cc
SIWS_URI=https://neonshift.cc
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
RULES_FILE=rules/v3.json
# 隔離 signer（同機 loopback）；token 與 signer.env 相同
ATTESTOR_SIGNER=http:http://127.0.0.1:6081
SIGNER_TOKEN=CHANGE_ME_openssl_rand_hex_32
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_PER_MINUTE=10
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_16
OPS_TOKEN=CHANGE_ME_openssl_rand_hex_16
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=10000
IDL_FILE=idl/neonshift_core.json
RETENTION_ENABLED=true
