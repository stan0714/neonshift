# dev 環境（devnet 整合）。公開資訊與路徑；金鑰在 ~/.config/neonshift/dev/
ENV_NAME=dev
CLUSTER=devnet
CLUSTER_ID=1
RPC_URL=https://api.devnet.solana.com
KEY_DIR=$HOME/.config/neonshift/dev
ADMIN_KEYPAIR=$KEY_DIR/admin.json
PROGRAM_KEYPAIR=$KEY_DIR/neonshift_core-keypair.json
ATTESTOR_KEYPAIR=$KEY_DIR/attestor.json
API_URL=https://api-dev.neonshift.cc/v1
# 部署後回填
PROGRAM_ID=6MhVoQHdEpY2hqkaNJMkT2vHWakfnGfEYDgCtJzh6ENA
TSKR_MINT=
REWARD_VAULT=
TREASURY_VAULT=
# 代幣（BRD 8.5 假設）：總供給 1,000,000、獎勵金庫預撥 200,000；單位 tSKR
TSKR_TOTAL_SUPPLY=1000000
TSKR_REWARD_FUND=200000
